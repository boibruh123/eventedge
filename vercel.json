{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/**/*.mjs": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
